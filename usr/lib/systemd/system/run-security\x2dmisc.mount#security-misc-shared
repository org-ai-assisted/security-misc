## AI-Assisted

## Dedicated hardened tmpfs backing the pam_namespace per-account instances for
## /tmp and /dev/shm (/etc/security/namespace.d/30_security-misc.conf). Mounted
## nosuid,nodev,noexec so the user-method bind mounts inherit that hardening -
## the 'user' method cannot set mntopts itself, unlike the 'tmpfs' method. The
## instances are therefore RAM-backed and wiped at every reboot, while shared
## across all of one account's sessions within a boot (no systemd --user split).
## Must be mounted before any user session and before tmpfiles creates the 0000
## instance-parent directories inside it.
##
## size=50% mirrors systemd's own tmp.mount; note this one tmpfs backs /tmp AND
## /dev/shm for every account, so the cap is shared (tune if needed).
## Unit filename is the systemd-escaped form of the mount path /run/security-misc.

[Unit]
Description=Hardened tmpfs for pam_namespace polyinstantiation instances
DefaultDependencies=no
After=run.mount
Before=local-fs.target systemd-tmpfiles-setup.service systemd-user-sessions.service
Conflicts=umount.target
Before=umount.target

[Mount]
What=tmpfs
Where=/run/security-misc
Type=tmpfs
Options=nosuid,nodev,noexec,mode=0755,size=50%

[Install]
WantedBy=local-fs.target
