## AI-Assisted

## Service gate for pam_namespace (namespace-security-misc pam-config). Mirrors
## pam_only_if_login / pam_only_if_su: decide by PAM_SERVICE whether the NEXT
## module (pam_namespace.so) runs.
##
## pam_namespace is woven into BOTH common-session and common-session-noninteractive
## so the systemd --user manager and cron/atd share one per-account instance with
## the interactive login. But common-session-noninteractive is pulled in by every
## root-daemon that opens a user PAM session (privleapd, polkit-1, sudo, the VBox
## guestcontrol 'login' harvest, ...); running pam_namespace there is unwanted (it
## needlessly (un)mounts the per-account instance and logs
## "Unmount of /var/tmp failed" for sessions that never needed polyinstantiation).
##
## So allow-list only the services whose sessions MUST share one account instance:
##   - interactive logins:         login greetd sshd su su-l
##   - the systemd --user manager:  systemd-user
##   - scheduled-job runners:       cron atd
## Any other service (daemon helper, sudo-i, polkit) is left on the shared dirs.
##
## NOTE: a login service NOT in this list silently gets NO polyinstantiation.
## Kicksecure ships greetd; if a different display manager is used (lightdm,
## sddm, gdm-password, ...) its PAM service name must be added here.
##
## Exit contract, consumed by [success=1 default=ignore] in the pam-config:
##   - PAM_SERVICE in list     -> exit 1 -> next module (pam_namespace) RUNS
##   - PAM_SERVICE not in list -> exit 0 -> next module (pam_namespace) SKIPPED
## https://serverfault.com/questions/134471/success-n-control-syntax-in-pam-conf-pam-d-files

set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

PAM_SERVICE="${PAM_SERVICE:-}"

true "PAM_SERVICE: ${PAM_SERVICE}"

namespace_service_list="login greetd sshd su su-l systemd-user cron atd"

for namespace_service_item in ${namespace_service_list} ; do
   if [ "${PAM_SERVICE}" = "${namespace_service_item}" ]; then
      ## exit failure so [success=1 default=ignore] will result in running the
      ## next PAM module (pam_namespace).
      exit 1
   fi
done

## exit success so [success=1 default=ignore] will result in skipping the
## next PAM module (pam_namespace).
exit 0
