#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## AI-Assisted

## Audit an SSH server against the security-misc hardened ssh-audit policy.
##
## Exit 0 only when the target presents EXACTLY the hardened algorithm set
## shipped by security-misc; any weaker, extra, or reordered algorithm fails
## (the policy sets allow_algorithm_subset_and_reordering = false). No legacy,
## no backwards compatibility.
##
## Scope: ssh-audit's policy compares the server-to-client algorithm lists.
## OpenSSH's Ciphers/MACs/KexAlgorithms apply to BOTH directions from a single
## list, so a security-misc-configured (OpenSSH) target is symmetric and the
## check is complete. It would not catch a non-OpenSSH peer offering weaker
## client-to-server algorithms only, which is not a target here.
##
## Usage: ssh-audit-test [--policy FILE] [--port PORT] [HOST ...]
##   default target 127.0.0.1:22, default policy the installed server policy.
##
## style-ok: no-has  (self-contained; helper-scripts not sourced)

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

me="${0##*/}"

die() {
   printf '%s\n' "${me}: ERROR: $1" >&2
   exit 1
}

info() {
   printf '%s\n' "${me}: $1" >&2
}

policy=""
port="22"
hosts=()

while [ "$#" -gt 0 ]; do
   case "$1" in
      --policy)
         if [ "$#" -lt 2 ]; then
            die "option --policy requires a value"
         fi
         policy="$2"
         shift 2
         ;;
      --port)
         if [ "$#" -lt 2 ]; then
            die "option --port requires a value"
         fi
         port="$2"
         shift 2
         ;;
      --)
         shift
         while [ "$#" -gt 0 ]; do
            hosts+=( "$1" )
            shift
         done
         break
         ;;
      -*)
         die "unknown option: $1"
         ;;
      *)
         hosts+=( "$1" )
         shift
         ;;
   esac
done

command -v ssh-audit >/dev/null 2>&1 \
   || die "ssh-audit not installed"

## Resolve the server policy: explicit --policy, else the installed file, else
## the in-repo source (SECURITY_MISC_REPO, whose tree keeps the genmkfile
## '#security-misc-shared' suffix).
if [ -z "${policy}" ]; then
   for candidate in \
      "/usr/share/security-misc/ssh-audit/server.policy" \
      "${SECURITY_MISC_REPO:-}/usr/share/security-misc/ssh-audit/server.policy#security-misc-shared"; do
      if [ -n "${candidate}" ] && [ -f "${candidate}" ]; then
         policy="${candidate}"
         break
      fi
   done
fi

if [ -z "${policy}" ] || [ ! -f "${policy}" ]; then
   die "server policy not found (pass --policy FILE)"
fi

if [ "${#hosts[@]}" -eq 0 ]; then
   hosts=( "127.0.0.1" )
fi

failed=0
for host in "${hosts[@]}"; do
   rc=0
   out="$(ssh-audit --port="${port}" --policy="${policy}" -- "${host}" 2>&1)" || rc=$?
   if [ "${rc}" -eq 0 ]; then
      info "PASS: ${host}:${port} matches ${policy##*/}"
   else
      failed=$(( failed + 1 ))
      printf '%s\n' "${out}"
      info "FAIL: ${host}:${port} does not match ${policy##*/}"
   fi
done

if [ "${failed}" -ne 0 ]; then
   die "${failed} host(s) failed the hardened policy"
fi

info "OK: all host(s) match the hardened policy"
