#!/bin/bash

## Copyright (C) 2019 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## features:
## - nodev,nosuid where appropriate
## - optional noexec for most except /home
## - optional noexec for all including /home
## - idempotent (script can be safely re-run)
## - can be run from:
##   - systemd
##   - dracut
##   - manually from command line
## - can safely handle non-existing folders
## - error handling
## - log output:
##   - shows each and every command executed
##   - shows old mount options prior running remount-secure
##   - shows new mount options after running remount-secure

## noexec in /tmp and/or /home can break some malware but also legitimate
## applications.

## https://www.kicksecure.com/wiki/Noexec
## https://www.kicksecure.com/wiki/Dev/remount-secure
## https://forums.whonix.org/t/re-mount-home-and-other-with-noexec-and-nosuid-among-other-useful-mount-options-for-better-security/7707

## style-ok: no-has - may run in dracut without helper-scripts

## Mount helper functions (_boot, _sys, _usr, ...) are invoked indirectly via
## the dispatch in main().
# shellcheck disable=SC2317

#set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

init() {
   running_as_root='false'
   most_noexec_maybe=''
   home_noexec_maybe=''

   if test -o xtrace ; then
      output_command=( true )
   else
      output_command=( printf '%s\n' )
   fi

   "${output_command[@]}" "$0: INFO: START"

   ## dracut sets NEWROOT=/sysroot
   [[ -v NEWROOT ]] || NEWROOT=""
   if [ "${NEWROOT}" = "" ]; then
      "${output_command[@]}" "INFO: dracut detected: no"
      if [ "$(id -u)" = "0" ]; then
         running_as_root='true'
      fi
   else
      "${output_command[@]}" "INFO: dracut detected: yes - NEWROOT: '${NEWROOT}'"
      ## dracut does not have id. Saving space in initial ramdisk.
      running_as_root='true'
   fi

   exit_code=0
   deviation_count=0

   ## Debugging.
   #echo "ls -la /root/"
   #ls -la / || true
   #echo "ls -la /sysroot/"
   #ls -la /sysroot/ || true
   #echo "env"
   #env || true
}

require_root_maybe() {
   if [ "${option_check}" = "false" ] \
      && [ "${running_as_root}" = 'false' ]; then
      "${output_command[@]}" "ERROR: must be run as root unless using --check! sudo $0"
      exit 1
   fi
}

level_to_mount_options() {
   ## Called exactly once per run (parse_options rejects more than one level),
   ## after init() has zeroed the level-gated noexec flags.
   case "${1:-}" in
      0)
         "${output_command[@]}" "WARNING: Not using remount-secure."
         exit 0
         ;;
      1)
         "${output_command[@]}" "INFO: level 1/3 (low)"
         ;;
      2)
         "${output_command[@]}" "INFO: level 2/3 (medium)"
         most_noexec_maybe=",noexec"
         ;;
      3)
         "${output_command[@]}" "INFO: level 3/3 (high)"
         most_noexec_maybe=",noexec"
         home_noexec_maybe=",noexec"
         ;;
      *)
         "${output_command[@]}" "ERROR: Unrecognized level '${1}'!"
         exit 1
         ;;
   esac
}

parse_options() {
   ## Thanks to:
   ## https://mywiki.wooledge.org/BashFAQ/035

   while :
   do
       case ${1:-} in
           0|1|2|3)
               ## A level is a single value. Reject a second one instead of
               ## silently picking a winner; record it and apply once after the
               ## loop so a leading '0' cannot opt out before a later level is
               ## seen.
               if [ "${parsed:-false}" = 'true' ]; then
                  "${output_command[@]}" "ERROR: only one level may be given." >&2
                  exit 1
               fi
               level_arg="${1}"
               parsed=true
               shift
               ;;
           --check)
               "${output_command[@]}" "INFO: --check (audit only)"
               option_check=true
               shift
               ;;
           --force)
               "${output_command[@]}" "INFO: --force"
               option_force=true
               shift
               ;;
           --)
               shift
               break
               ;;
           -*)
               "${output_command[@]}" "ERROR: unknown option: ${1}" >&2
               exit 1
               ;;
           *)
               if [ -n "${1:-}" ]; then
                  "${output_command[@]}" "ERROR: unexpected argument: ${1}" >&2
                  exit 1
               fi
               break
               ;;
       esac
   done

   [[ -v option_check ]] || option_check=false
   [[ -v option_force ]] || option_force=""
   [[ -v parsed ]] || parsed=false
   [[ -v level_arg ]] || level_arg=""
   [[ -v home_noexec_maybe ]] || home_noexec_maybe=""
   [[ -v most_noexec_maybe ]] || most_noexec_maybe=""

   ## Apply the single explicit level if one was given; otherwise (the dracut and
   ## manual 'remount-secure' path with no level) resolve it from the drop-in
   ## configuration, honoring the 'noremountsecure' kernel-cmdline debug
   ## off-switch. level_to_mount_options 0 exits, so only levels 1-3 reach the
   ## summary below.
   if [ "${parsed}" = 'true' ]; then
      level_to_mount_options "${level_arg}"
   else
      ## Resolve in the MAIN shell (NOT a '$()' subshell) so a drop-in '*.conf'
      ## sourced during level resolution can also redefine the mount-helper
      ## functions (e.g. '_opt', '_home') before the dispatch below runs, letting
      ## an admin customize per-mountpoint options. Side effects are intentional
      ## here; a broken root-authored drop-in can therefore abort the run (the
      ## accepted tradeoff of function override). stdout (the printed level) is
      ## discarded -- a redirect, not a pipe, so no subshell -- and the resolved
      ## value is read from the global 'remount_secure_effective_level'.
      resolve_effective_level >/dev/null
      level_to_mount_options "${remount_secure_effective_level}"
      parsed='true'
   fi

   "${output_command[@]}" "INFO: using nosuid,nodev: yes"

   if [ "${home_noexec_maybe}" = "" ]; then
      "${output_command[@]}" "INFO: using noexec for all: no"
   else
      "${output_command[@]}" "INFO: using noexec for all: yes"
      return 0
   fi

   if [ "${most_noexec_maybe}" = "" ]; then
      "${output_command[@]}" "INFO: using noexec for most: no"
   else
      "${output_command[@]}" "INFO: using noexec for most (not all): yes"
      return 0
   fi

   return 0
}

preparation() {
   ## Debugging.
   #"${output_command[@]}" "INFO: 'findmnt --list' output at the START."
   #"${output_command[@]}" "$(findmnt --list)"
   #"${output_command[@]}" ""

   ## Create the status-file directory only on the real remount path. '--check'
   ## is a read-only audit and must not write, so a root '--check' on a
   ## read-only '/run' cannot abort before the audit runs.
   if [ "${option_check}" = "false" ]; then
      mkdir --parents -- "${remount_secure_runtime_dir}"
   fi
}

remount_secure() {
   if [ "${option_check}" = "true" ]; then
      audit_mount_options
      return 0
   fi

   "${output_command[@]}" ""

   ## ${FUNCNAME[1]} is the name of the calling function. I.e. the function
   ## which called this function.
   status_file_name="${FUNCNAME[1]}"
   ## example status_file_name:
   ## _home
   status_file_full_path="${remount_secure_runtime_dir}/${status_file_name}"
   ## example status_file_full_path:
   ## /run/remount-secure/_home

   old_mount_options="$(findmnt --noheadings --output options -- "${mount_folder}")" || true
   ## example old_mount_options:
   ## rw,nosuid,nodev,relatime,discard

   "${output_command[@]}" "INFO: '${mount_folder}' old_mount_options: '${old_mount_options}'"

   if printf '%s\n' "${old_mount_options}" | grep "${intended_mount_options}" >/dev/null 2>/dev/null ; then
      "${output_command[@]}" "INFO: '${mount_folder}' has already intended mount options. ('${intended_mount_options}')"
      return 0
   fi

   ## When this package is upgraded, the systemd unit will run again.
   ## If the user meanwhile manually relaxed mount options, this should not be undone.

   if [ ! "${option_force}" == "true" ]; then
      if [ -e "${status_file_full_path}" ]; then
         "${output_command[@]}" "INFO: '${mount_folder}' already remounted earlier. Not remounting again. Use --force if this is what you want."
         return 0
      fi
   fi

   if ! test -d "${mount_folder}" ; then
      ## For example /boot/efi does not always exist on all systems.
      "${output_command[@]}" "INFO: '${mount_folder}' folder exists: no"
      return 0
   fi
   "${output_command[@]}" "INFO: '${mount_folder}' folder exists: yes"

   if findmnt --noheadings "${mount_folder}" >/dev/null ; then
      "${output_command[@]}" "INFO: '${mount_folder}' already mounted, therefore using remount."
      "${output_command[@]}" "INFO: Executing: mount --make-private --options remount,${intended_mount_options} ${mount_folder}"
      mount --make-private --options "remount,${intended_mount_options}" "${mount_folder}" || exit_code=100
   else
      "${output_command[@]}" "INFO: '${mount_folder}' not yet mounted, therefore using recursive bind mount."
      "${output_command[@]}" "INFO: Executing: mount --make-private --options ${intended_mount_options} --rbind ${mount_folder} ${mount_folder}"
      mount --make-private --options "${intended_mount_options}" --rbind "${mount_folder}" "${mount_folder}" || exit_code=101
   fi

   new_mount_options="$(findmnt --noheadings --output options -- "${mount_folder}")" || true
   "${output_command[@]}" "INFO: '${mount_folder}' new_mount_options: '${new_mount_options}'"

   touch "${status_file_full_path}"
}

audit_mount_options() {
   local live_options intended_rest intended_option missing findmnt_rc

   findmnt_rc=0
   live_options="$(findmnt --noheadings --output options --target "${mount_folder}" | tail -n 1)" || findmnt_rc="$?"

   ## findmnt exit status: 0 = found; 1 = no mount for this path (absent -> N/A);
   ## >= 2 = error reading the mount table (fail closed as a deviation).
   ## live_options should always contain at least "ro" or "rw".
   if [ "${findmnt_rc}" = "1" ] ; then
      "${output_command[@]}" "N/A: '${mount_folder}' no mount found"
      return 0
   fi
   if [ "${findmnt_rc}" != "0" ] || [ -z "${live_options}" ] ; then
      "${output_command[@]}" "DEVIATION: '${mount_folder}' mount options unreadable (findmnt rc: '${findmnt_rc}')"
      deviation_count=$((deviation_count + 1))
      return 0
   fi

   missing=""
   intended_rest="${intended_mount_options}"
   while [ -n "${intended_rest}" ] ; do
      intended_option="${intended_rest%%,*}"
      case ",${live_options}," in
         *",${intended_option},"*)
            true "INFO: '${mount_folder}' has '${intended_option}'"
            ;;
         *)
            missing="${missing:+"${missing},"}${intended_option}"
            ;;
      esac
      if [ "${intended_rest}" = "${intended_option}" ] ; then
         intended_rest=""
      else
         intended_rest="${intended_rest#*,}"
      fi
   done

   if [ -n "${missing}" ] ; then
      "${output_command[@]}" "DEVIATION: '${mount_folder}' missing '${missing}' (have: '${live_options}')"
      deviation_count=$((deviation_count + 1))
   else
      "${output_command[@]}" "OK: '${mount_folder}' has intended mount options ('${intended_mount_options}')"
   fi
}

_boot() {
   mount_folder="${NEWROOT}/boot"
   ## https://lists.freedesktop.org/archives/systemd-devel/2015-February/028456.html
   intended_mount_options="nosuid,nodev,noexec"
   remount_secure
}

_boot_efi() {
   mount_folder="${NEWROOT}/boot/efi"
   intended_mount_options="nosuid,nodev,noexec"
   remount_secure
}

_run() {
   mount_folder="/run"
   ## https://lists.freedesktop.org/archives/systemd-devel/2015-February/028456.html
   intended_mount_options="nosuid,nodev${most_noexec_maybe}"
   remount_secure
}

_dev() {
   mount_folder="/dev"
   ## /dev should be nosuid,noexec as per:
   ## https://bugs.launchpad.net/ubuntu/+source/systemd/+bug/1991975
   intended_mount_options="nosuid,noexec"
   remount_secure
}

_dev_shm() {
   mount_folder="/dev/shm"
   intended_mount_options="nosuid,nodev${most_noexec_maybe}"
   remount_secure
}

_proc() {
   mount_folder="/proc"
   ## Safe subset. procfs has no suid files, no device nodes and no executable regular
   ## files; /proc/self/exe is a symlink to the real binary, so noexec does not block
   ## re-exec. hidepid=2,gid=proc is deliberately NOT set here: it breaks pkexec/polkit
   ## process lookup (the reason proc-hidepid.service stays disabled).
   intended_mount_options="nosuid,nodev,noexec"
   remount_secure
}

_sys() {
   mount_folder="/sys"
   intended_mount_options="nosuid,nodev,noexec"
   remount_secure
}

_tmp() {
   mount_folder="${NEWROOT}/tmp"
   intended_mount_options="nosuid,nodev${most_noexec_maybe}"
   remount_secure
}

_var_tmp() {
   mount_folder="${NEWROOT}/var/tmp"
   intended_mount_options="nosuid,nodev${most_noexec_maybe}"
   remount_secure
}

_var_log() {
   mount_folder="${NEWROOT}/var/log"
   intended_mount_options="nosuid,nodev,noexec"
   remount_secure
}

_var_cache() {
   mount_folder="${NEWROOT}/var/cache"
   ## noexec here is intended. vbox-guest-installer (vm-config-dist) extracts and
   ## runs the VirtualBox Guest Additions installer from /var/lib/vm-config-dist
   ## (exec-allowed), not /var/cache, so a noexec /var/cache does not break it.
   intended_mount_options="nosuid,nodev${most_noexec_maybe}"
   remount_secure
}

_var() {
   mount_folder="${NEWROOT}/var"
   ## noexec: Not possible. Reason:
   ## Debian stores executable maintainer scripts in /var/lib/dpkg/info folder.
   intended_mount_options="nosuid,nodev"
   remount_secure
}

_usr() {
   mount_folder="${NEWROOT}/usr"
   intended_mount_options="nodev"
   remount_secure
}

_home() {
   mount_folder="${NEWROOT}/home"
   intended_mount_options="nosuid,nodev${home_noexec_maybe}"
   remount_secure
}

_root() {
   mount_folder="${NEWROOT}/root"
   intended_mount_options="nosuid,nodev${home_noexec_maybe}"
   remount_secure
}

_srv() {
   mount_folder="${NEWROOT}/srv"
   intended_mount_options="nosuid,nodev${most_noexec_maybe}"
   remount_secure
}

_media() {
   mount_folder="${NEWROOT}/media"
   intended_mount_options="nosuid,nodev${most_noexec_maybe}"
   remount_secure
}

_mnt() {
   mount_folder="${NEWROOT}/mnt"
   intended_mount_options="nosuid,nodev${most_noexec_maybe}"
   remount_secure
}

_opt() {
   mount_folder="${NEWROOT}/opt"
   ## Allow /opt exec as usually optional binaries are placed there such as Firefox
   ## when manually installed from tarball.
   intended_mount_options="nosuid,nodev"
   remount_secure
}

_etc() {
   ## /etc cannot be noexec because various executables are there. To find, run:
   ## sudo find /etc -executable
   mount_folder="${NEWROOT}/etc"
   intended_mount_options="nosuid,nodev"
   remount_secure
}

end() {
   ## Debugging.
   #"${output_command[@]}" "INFO: 'findmnt --list' output at the END."
   #"${output_command[@]}" "$(findmnt --list)"

   ## Fail closed on any audited deviation (missing option or unreadable mount).
   ## Computed once here, after every mountpoint, so an early return in the
   ## per-mount audit cannot bypass the failing exit.
   if [ "${deviation_count}" -gt 0 ] ; then
      exit_code=1
   fi

   "${output_command[@]}" ""
   "${output_command[@]}" "INFO: exit_code: ${exit_code}"
   "${output_command[@]}" "$0: INFO: END"
   exit "${exit_code}"
}

## Drop-in configuration directories (system + local admin). Overridable via
## environment for testing. The default level is hardcoded; drop-ins override it.
remount_secure_etc_dropin_dir="${remount_secure_etc_dropin_dir:-/etc/remount-secure.d}"
remount_secure_local_dropin_dir="${remount_secure_local_dropin_dir:-/usr/local/etc/remount-secure.d}"
## Written by '--set-level'. A later '/usr/local/etc' drop-in or a
## higher-numbered admin drop-in can still override it (last sourced wins).
remount_secure_managed_conf="${remount_secure_managed_conf:-${remount_secure_etc_dropin_dir}/40_managed.conf}"
## Default when no drop-in sets 'remount_secure_level' (enabled at level 3).
remount_secure_default_level="${remount_secure_default_level:-3}"
## Kernel command line source (overridable for testing).
remount_secure_cmdline_file="${remount_secure_cmdline_file:-/proc/cmdline}"
## Runtime status-file directory (overridable for testing). Holds the per-mount
## '_home'/'_tmp'/... markers; created only on the real remount path, never by
## '--check' (the audit must not write).
remount_secure_runtime_dir="${remount_secure_runtime_dir:-/run/remount-secure}"
## Internal: the level actually enforced this run. Set by resolve_effective_level
## (both the 'noremountsecure' cmdline off-switch and the drop-in path), so the
## real-run path can read it WITHOUT a '$()' subshell and thereby keep any
## function/variable overrides a drop-in made while it was sourced.
remount_secure_effective_level=''

read_dropin_level() {
   ## Print the drop-in-configured level (0-3); defaults to
   ## remount_secure_default_level. The trusted '*.conf' fragments are sourced
   ## via the shared, hardened 'source_config' helper (ownership/mode/symlink
   ## checks plus 'bash -n'); later directories and files win. Full-OS only: the
   ## dracut initramfs lacks helper-scripts and reaches remount-secure via an
   ## explicit argv level instead, so this is never used there.
   local source_folder_helper level
   source_folder_helper="${HELPER_SCRIPTS_PATH:-}/usr/libexec/helper-scripts/source_folder.bsh"
   remount_secure_level=''
   if [ -r "${source_folder_helper}" ]; then
      # shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/source_folder.bsh
      source "${source_folder_helper}"
      if ! source_config "${remount_secure_etc_dropin_dir}" "${remount_secure_local_dropin_dir}"; then
         printf '%s\n' "$0: WARNING: reading remount-secure drop-in configuration failed; using the most restrictive level 3." >&2
         ## Fail closed to the hardcoded most-restrictive level. A failed read can
         ## leave partial or inconsistent state in both remount_secure_level and
         ## remount_secure_default_level (fragments are sourced into this shell),
         ## so derive the fallback from neither: emit the literal and return.
         remount_secure_effective_level=3
         printf '%s\n' 3
         return 0
      fi
   fi
   level="${remount_secure_level:-${remount_secure_default_level}}"
   case "${level}" in
      0|1|2|3)
         ;;
      *)
         printf '%s\n' "$0: WARNING: invalid configured level '${level}'; using default ${remount_secure_default_level}." >&2
         level="${remount_secure_default_level}"
         ;;
   esac
   remount_secure_effective_level="${level}"
   printf '%s\n' "${level}"
}

resolve_effective_level() {
   ## The level actually enforced at boot: the 'noremountsecure' kernel-cmdline
   ## debug off-switch wins (level 0, to recover from an exec-related boot
   ## problem), otherwise the drop-in configuration.
   local cmdline
   cmdline=''
   if [ -r "${remount_secure_cmdline_file}" ]; then
      read -r cmdline < "${remount_secure_cmdline_file}" || true
   elif [ -r /proc/1/cmdline ]; then
      cmdline="$(tr '\0' ' ' < /proc/1/cmdline)" || true
   fi
   case " ${cmdline} " in
      *" noremountsecure "*)
         remount_secure_effective_level=0
         printf '%s\n' 0
         return 0
         ;;
   esac
   read_dropin_level
}

get_level() {
   ## Print the configured remount-secure level (0-3) for GUIs/CLIs (e.g.
   ## sysmaint-panel). Reports the persistent drop-in level, not the transient
   ## 'noremountsecure' debug override.
   read_dropin_level
}

set_level() {
   ## Record the chosen level in a managed drop-in. Applied on the next boot (or
   ## immediately via 'remount-secure --force <level>'). Level 0 disables
   ## remount-secure (it then no-ops at boot).
   local level dir tmp
   level="${1:-}"
   case "${level}" in
      0|1|2|3)
         ;;
      *)
         printf '%s\n' "ERROR: invalid level '${level}', expected 0, 1, 2, or 3." >&2
         exit 1
         ;;
   esac

   dir="$(dirname -- "${remount_secure_managed_conf}")"
   mkdir --parents -- "${dir}"
   tmp="$(mktemp -- "${remount_secure_managed_conf}.XXXXXX")"
   {
      printf '%s\n' '## Copyright (C) 2025 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>'
      printf '%s\n' '## See the file COPYING for copying conditions.'
      printf '%s\n' '##'
      printf '%s\n' "## Managed by 'remount-secure --set-level'. Do not edit by hand."
      printf '%s\n' '## https://www.kicksecure.com/wiki/Noexec'
      printf '%s\n' "remount_secure_level=${level}"
   } > "${tmp}"
   ## World-readable: '--set-level' runs as root but '--get-level' is read
   ## unprivileged (e.g. by the GUI), and mktemp creates 0600. The level is not
   ## secret.
   chmod 0644 -- "${tmp}"
   mv -- "${tmp}" "${remount_secure_managed_conf}"
   printf '%s\n' "INFO: remount-secure level set to '${level}' in '${remount_secure_managed_conf}'."
   printf '%s\n' "INFO: A reboot is required for the change to take effect (or run 'remount-secure --force ${level}')."
}

runtime_dir() {
   ## Harden the per-user XDG_RUNTIME_DIR (/run/user/<uid>) that systemd-logind
   ## mounts per login. logind hardcodes nosuid,nodev (never noexec) and offers no
   ## option for it, so this is invoked from an ExecStartPost drop-in on
   ## user-runtime-dir@.service, AFTER logind has mounted and chowned the dir.
   ## Runs per login against a FRESH tmpfs, so it always remounts (no status-file
   ## skip, unlike the boot-time dispatch). noexec is added only at level >= 2
   ## (matching /run); logind's nosuid,nodev already cover levels 0-1, so there is
   ## nothing to add below 2. The 'noremountsecure' cmdline off-switch (-> level 0)
   ## disables it too, via resolve_effective_level.
   local uid effective_level
   uid="${1:-}"
   ## '%i' from the unit is the uid; require it numeric before it reaches a mount path.
   case "${uid}" in
      ''|*[!0-9]*)
         printf '%s\n' "$0: ERROR: --runtime-dir requires a numeric uid, got '${uid}'." >&2
         exit 1
         ;;
   esac
   if [ "$(id -u)" != "0" ]; then
      printf '%s\n' "$0: ERROR: --runtime-dir must run as root." >&2
      exit 1
   fi
   effective_level="$(resolve_effective_level)"
   if [ "${effective_level}" -lt 2 ]; then
      printf '%s\n' "$0: INFO: level ${effective_level}: /run/user/${uid} kept at logind's nosuid,nodev (noexec starts at level 2)."
      return 0
   fi
   if ! findmnt --noheadings -- "/run/user/${uid}" >/dev/null 2>&1 ; then
      printf '%s\n' "$0: INFO: /run/user/${uid} not mounted; nothing to remount." >&2
      return 0
   fi
   printf '%s\n' "$0: INFO: Executing: mount --make-private --options remount,nosuid,nodev,noexec /run/user/${uid}"
   mount --make-private --options "remount,nosuid,nodev,noexec" "/run/user/${uid}"
}

main() {
   ## Configuration subcommands (full OS only; never used in dracut, which
   ## invokes 'remount-secure <level>' directly).
   case "${1:-}" in
      --runtime-dir)
         ## Per-login hardening of /run/user/<uid>, from the
         ## user-runtime-dir@.service ExecStartPost drop-in. Single mountpoint, not
         ## the full boot-time dispatch.
         shift
         runtime_dir "${1:-}"
         exit 0
         ;;
      --get-level)
         get_level
         exit 0
         ;;
      --get-effective-level)
         ## The level ACTUALLY enforced at boot: the 'noremountsecure' kernel
         ## cmdline off-switch (-> 0) wins over the drop-in configuration. A
         ## status check (systemcheck) must use this, not '--get-level', or a
         ## 'noremountsecure' boot reports the persistent level while hardening is
         ## actually off.
         resolve_effective_level
         exit 0
         ;;
      --set-level)
         shift
         set_level "${1:-}"
         exit 0
         ;;
   esac

   init
   parse_options "$@"
   require_root_maybe
   preparation

   _boot
   _boot_efi
   _run
   _dev
   _dev_shm
   _proc
   _sys
   _tmp
   _var_tmp
   _var_log
   _var_cache
   _var
   _usr
   _home
   _root
   _srv
   _media
   _mnt
   _opt
   _etc

   end
}

## REMINDER: see also hidepid /usr/lib/systemd/system/proc-hidepid.service
#mount --options defaults,nosuid,nodev,noexec,remount,subset=pid /proc

main "$@"
